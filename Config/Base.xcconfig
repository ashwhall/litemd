// Ad-hoc signing by default, so the project builds without an Apple team.
// To sign with your own certificate, create Config/Signing.local.xcconfig
// (gitignored), for example:
//   CODE_SIGN_IDENTITY = Developer ID Application
//   DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
